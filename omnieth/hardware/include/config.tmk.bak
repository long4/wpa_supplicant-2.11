###############################################################################

# Set the Makefile config macros to zero by default
OSI_STRIPPED_LIB := 0
OSI_DEBUG := 0
DEBUG_MACSEC := 0

ifeq ($(IS_RELEASE),1)
        HW_CFLAGS += -DOSI_STRIPPED_LIB
	OSI_STRIPPED_LIB := 1
	#Enable for function trace
	EN_OSI_RM_FTRACE := 0
else
        HW_CFLAGS += -DOSI_DEBUG
        HW_CFLAGS += -DDEBUG_MACSEC
	OSI_DEBUG := 1
	DEBUG_MACSEC := 1
endif
#HW_CFLAGS += -DHSI_SUPPORT
HW_CFLAGS += -DMACSEC_SUPPORT
HW_CFLAGS += -DLOG_OSI
HW_CFLAGS += -DPHY_PROG

ifeq ($(IS_OMNI_TEST),1)
HW_CFLAGS                += -DOMNI_TEST
endif

#HW_CFLAGS += -DMACSEC_KEY_PROGRAM
HW_CFLAGS += -DMACSEC_KEY_PROGRAM
HW_CFLAGS += -DCONFIG_MACSEC
#HW_CFLAGS += -DDWC_MACSEC_USE_TCAM
HSI_SUPPORT := 1
MACSEC_SUPPORT := 1
PHY_PROG := 1
#MACSEC_KEY_PROGRAM := 1
ccflags-y += $(HW_CFLAGS)
